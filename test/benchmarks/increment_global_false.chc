(set-logic HORN)
(declare-fun |increment1_entry| ( Int Int) Bool )
(declare-fun |increment1_exit| ( Int Int) Bool )
(declare-fun |increment| ( Bool Bool Int Int) Bool )
(declare-fun |main1_entry| ( Int) Bool )
(declare-fun |main1_exit| ( Int Bool Int) Bool )
(declare-fun |main4_entry| ( Int) Bool )
(declare-fun |main2_entry| ( Int Int) Bool )
(declare-fun |main2_exit| ( Bool Int Bool) Bool )
(declare-fun |main_error| () Bool )
(declare-fun |main4_exit| ( Int) Bool )
(declare-fun |main| ( Int Int) Bool )

(assert 
 (forall ( ( g0 Int )( g0_1 Int ) )
  (=>  
   (= g0_1 g0 )
   (increment1_entry g0 g0_1 )
  )
 )
)
(assert 
 (forall ( ( %i Int )( %i1 Int )( g0 Int )( g0_1 Int )( g0_2 Int ) )
  (=>  
   (and (= %i g0_1 ) (= %i1 (+ %i 1 )) (= g0_2 %i1 ) (increment1_entry g0 g0_1 ) )
   (increment1_exit g0 g0_2 )
  )
 )
)
(assert 
 (forall ( ( g0 Int )( g0_2 Int ) )
  (=>  
   (increment1_exit g0 g0_2 )
   (increment false false g0 g0_2 )
  )
 )
)
(assert 
 (forall ( ( g0 Int )( g0_2 Int ) )
  (increment true true g0 g0_2 )
 )
)
(assert 
 (forall ( ( g0_3 Int ) )
  (=>  
   (= g0_3 0 )
   (main1_entry g0_3 )
  )
 )
)
(assert 
 (forall ( ( %i Int )( %i1 Int )( %i2 Bool )( g0_3 Int )( g0_4 Int ) )
  (=>  
   (and true (= g0_4 %i ) (= %i1 g0_4 ) (= %i2 (> %i1 100 )) (main1_entry g0_3 ) )
   (main1_exit %i1 %i2 g0_4 )
  )
 )
)
(assert 
 (forall ( ( %i1 Int )( %i2 Bool )( g0_4 Int ) )
  (=>  
   (and (main1_exit %i1 %i2 g0_4 ) (= %i2 true ) )
   (main4_entry g0_4 )
  )
 )
)
(assert 
 (forall ( ( %i1 Int )( %i2 Bool )( g0_4 Int ) )
  (=>  
   (and (main1_exit %i1 %i2 g0_4 ) (= %i2 false ) )
   (main2_entry %i1 g0_4 )
  )
 )
)
(assert 
 (forall ( ( %i1 Int )( %i4 Int )( %i5 Bool )( e1 Bool )( g0_4 Int )( g0_5 Int ) )
  (=>  
   (and (increment false e1 g0_4 g0_5 ) (= %i4 g0_5 ) (= %i5 (= %i4 %i1 )) (main2_entry %i1 g0_4 ) )
   (main2_exit %i5 g0_5 e1 )
  )
 )
)
(assert 
 (forall ( ( %i5 Bool )( g0_5 Int ) )
  (=>  
   (and (main2_exit %i5 g0_5 false ) (= %i5 true ) )
   (main4_entry g0_5 )
  )
 )
)
(assert 
 (forall ( ( %i5 Bool )( g0_5 Int ) )
  (=>  
   (and (main2_exit %i5 g0_5 false ) (= %i5 false ) )
   main_error
  )
 )
)
(assert 
 (forall ( ( %i5 Bool )( g0_5 Int ) )
  (=>  
   (main2_exit %i5 g0_5 true )
   main_error
  )
 )
)
(assert 
 (forall ( ( g0_5 Int ) )
  (=>  
   (main4_entry g0_5 )
   (main4_exit g0_5 )
  )
 )
)
(assert 
 (forall ( ( g0_5 Int ) )
  (=>  
   (main4_exit g0_5 )
   (main 0 g0_5 )
  )
 )
)
(assert 
 (forall ( ( HORNIX_UNUSED Bool ) )
  (=>  
   main_error
   false
  )
 )
)

(check-sat)
(get-model)
